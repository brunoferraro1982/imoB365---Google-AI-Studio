# Gemini AI (server-side only) — descrições de imóveis, scoring, chat
GEMINI_API_KEY="your-gemini-api-key"

# Supabase — em dev local, aponta para o projeto Supabase Cloud de desenvolvimento
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# URL canônica da aplicação (callbacks de OAuth, links self-referenciais)
APP_URL="http://localhost:8080"

# Mercado Pago (checkout/assinaturas — opcional em dev)
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-access-token"
MERCADOPAGO_WEBHOOK_SECRET="your-mercadopago-webhook-secret"

# Mercado Pago Marketplace (OAuth por tenant — Fase 3 do módulo Financeiro,
# distinto do token acima, que é da própria plataforma)
MERCADOPAGO_MARKETPLACE_CLIENT_ID="your-mercadopago-marketplace-client-id"
MERCADOPAGO_MARKETPLACE_CLIENT_SECRET="your-mercadopago-marketplace-client-secret"

# Secret do webhook da aplicação Marketplace (Fase 3 parte 2 — cobrança real
# dos tenants pros próprios clientes finais; distinto de
# MERCADOPAGO_WEBHOOK_SECRET, que é do app de assinatura SaaS)
MERCADOPAGO_MARKETPLACE_WEBHOOK_SECRET="your-mercadopago-marketplace-webhook-secret"

# API da Hostinger (opcional — painel de infraestrutura real em
# /admin/status: CPU/RAM/disco da VPS de produção). Token gerado em
# hPanel > Dev Tools > API. Sem essas duas variáveis a seção só mostra
# "não configurado", sem quebrar o resto da página.
HOSTINGER_API_TOKEN="your-hostinger-api-token"
HOSTINGER_VPS_ID="your-hostinger-vps-id"

# Meta App (Facebook/Instagram) — registrado UMA VEZ pelo imoB365 no Meta
# for Developers (produtos "Facebook Login for Business", "Marketing API" e
# "Leads Retrieval"), contra o qual cada tenant se conecta individualmente
# via OAuth (ver src/lib/metaOAuth.functions.ts) — publica o catálogo de
# imóveis no Facebook/Instagram e recebe de volta os leads de campanhas.
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
# String secreta escolhida pelo imoB365, cadastrada tanto no painel de
# webhooks do Meta App quanto aqui — usada só no desafio de verificação
# GET do webhook de Lead Ads (Fase 3)
META_WEBHOOK_VERIFY_TOKEN="your-meta-webhook-verify-token"

# Google Drive API (opcional — só necessária pra ingestão automatizada de
# empreendimentos/imóveis de construtoras parceiras que divulgam mídia via
# Google Drive, ex.: GMV). Chave de API do Google Cloud com a Drive API
# habilitada, restrita só a essa API (sem escopo de escrita). Sem essa
# variável, a descoberta de lotes (Linktree) continua funcionando, só a
# coleta de mídia dentro das pastas do Drive fica marcada como erro por
# lote, sem derrubar o restante da sincronização.
GOOGLE_DRIVE_API_KEY="your-google-drive-api-key"
